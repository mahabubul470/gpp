{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mahabubul470/gpp",
  "description": "Project knowledge graph with history-checked belief staleness, changeset proposals, cost reporting",
  "repository": {
    "url": "https://github.com/mahabubul470/gpp",
    "source": "github"
  },
  "version": "0.2.2",
  "websiteUrl": "https://mahabubul470.github.io/gpp/",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "gpp-cli",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp-server"
        },
        {
          "type": "positional",
          "value": "--stdio"
        }
      ]
    }
  ]
}
